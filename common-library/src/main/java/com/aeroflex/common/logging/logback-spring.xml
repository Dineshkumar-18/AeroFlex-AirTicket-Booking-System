<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- ===================================================== -->
    <!-- Service Name                                          -->
    <!-- ===================================================== -->
    <!--
        Comes from:
            spring.application.name

        Example:
            identity-service
            flight-service
            booking-service

        Defaults to "aeroflex-service" for local development.
    -->
    <springProperty scope="context"
                    name="SERVICE_NAME"
                    source="spring.application.name"
                    defaultValue="aeroflex-service"/>


    <!-- ===================================================== -->
    <!-- Pod Name                                               -->
    <!-- ===================================================== -->
    <!--
        Kubernetes provides POD_NAME using the Downward API.

        Local development:
            POD_NAME is not available
            -> defaults to "local"
    -->
    <property name="POD_NAME"
              value="${POD_NAME:-local}"/>


    <!-- ===================================================== -->
    <!-- Log Base Directory                                     -->
    <!-- ===================================================== -->
    <!--
        Local:
            LOG_BASE_DIR is not set
            -> logs

        Kubernetes:
            LOG_BASE_DIR=/logs

        This allows the same configuration to work in both
        local development and Kubernetes.
    -->
    <property name="LOG_BASE_DIR"
              value="${LOG_BASE_DIR:-logs}"/>


    <!-- ===================================================== -->
    <!-- Service Log Directory                                  -->
    <!-- ===================================================== -->
    <!--
        Local example:
            logs/identity-service

        Kubernetes example:
            /logs/identity-service
    -->
    <property name="LOG_DIR"
              value="${LOG_BASE_DIR}/${SERVICE_NAME}"/>


    <!-- ===================================================== -->
    <!-- Current Log File                                       -->
    <!-- ===================================================== -->
    <!--
        Example:

        identity-service:
            logs/identity-service/local.log

        Kubernetes:
            /logs/identity-service/identity-service-7f8c9d6b4f-xk29p.log
    -->
    <property name="LOG_FILE"
              value="${LOG_DIR}/${POD_NAME}.log"/>


    <!-- ===================================================== -->
    <!-- Log Pattern                                            -->
    <!-- ===================================================== -->

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [traceId=%X{traceId}] [spanId=%X{spanId}] %logger{36} - %msg%n"/>


    <!-- ===================================================== -->
    <!-- Console Appender                                       -->
    <!-- ===================================================== -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ===================================================== -->
    <!-- File Appender                                          -->
    <!-- ===================================================== -->

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!--
            Current active log file.

            Example:
                /logs/identity-service/
                identity-service-7f8c9d6b4f-xk29p.log
        -->
        <file>${LOG_FILE}</file>


        <!-- ================================================= -->
        <!-- Size + Time Based Rolling                         -->
        <!-- ================================================= -->

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!--
                %d = date
                %i = rolling index

                Example:

                identity-service-abc123.2026-09-20.0.log
                identity-service-abc123.2026-09-20.1.log
                identity-service-abc123.2026-09-20.2.log
            -->
            <fileNamePattern>
                ${LOG_DIR}/${POD_NAME}.%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>


            <!-- Roll when a file reaches 50 MB -->
            <maxFileSize>50MB</maxFileSize>


            <!-- Keep logs for 30 days -->
            <maxHistory>30</maxHistory>


            <!-- Maximum total size of archived logs -->
            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>


        <!-- Log format -->
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ===================================================== -->
    <!-- Root Logger                                            -->
    <!-- ===================================================== -->

    <root level="INFO">

        <!-- Console output -->
        <appender-ref ref="CONSOLE"/>

        <!-- File output -->
        <appender-ref ref="FILE"/>

    </root>

</configuration>